<% if (page.total > 1) { %>
<nav class="pagination" aria-label="分页">
  <% if (page.prev) { %>
    <a class="page-link" href="<%= url_for(page.prev_link) %>"><%- icon('chevron-left') %>上一页</a>
  <% } else { %>
    <span class="page-link disabled"><%- icon('chevron-left') %>上一页</span>
  <% } %>
  <span class="page-info"><%= page.current %> / <%= page.total %></span>
  <% if (page.next) { %>
    <a class="page-link" href="<%= url_for(page.next_link) %>">下一页<%- icon('arrow') %></a>
  <% } else { %>
    <span class="page-link disabled">下一页<%- icon('arrow') %></span>
  <% } %>
</nav>
<% } %>
