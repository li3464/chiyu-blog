<section class="card timeline">
  <% var posts = site.posts.sort('date', -1); %>
  <% var year = 0; %>
  <% posts.each(function (post) { %>
    <% var y = date(post.date, 'YYYY'); %>
    <% if (y !== year) { year = y; %>
      <h2 class="timeline-year"><%= y %></h2>
    <% } %>
    <div class="timeline-item">
      <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MM-DD') %></time>
      <a href="<%= url_for(post.path) %>"><%= post.title %></a>
      <% if (post.categories && post.categories.length) { %>
        <span class="timeline-cat"><%= post.categories.first().name %></span>
      <% } %>
    </div>
  <% }); %>
</section>
