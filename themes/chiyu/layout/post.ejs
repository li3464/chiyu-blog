<article class="post">
  <header class="post-header">
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, config.date_format) %></time>
      <% if (page.categories && page.categories.length) { %>
        <span class="meta-sep">·</span>
        <% page.categories.each(function (cat) { %>
          <a class="meta-link" href="<%= url_for(cat.path) %>"><%= cat.name %></a>
        <% }); %>
      <% } %>
    </div>
  </header>

  <div class="post-content"><%- page.content %></div>

  <% if (page.tags && page.tags.length) { %>
    <div class="post-tags">
      <% page.tags.each(function (tag) { %>
        <a class="tag-chip" href="<%= url_for(tag.path) %>"># <%= tag.name %></a>
      <% }); %>
    </div>
  <% } %>

  <nav class="post-nav">
    <% if (page.prev) { %>
      <a class="post-nav-link prev" href="<%= url_for(page.prev.path) %>"><span>← 上一篇</span><%= page.prev.title %></a>
    <% } else { %><span class="post-nav-link placeholder"></span><% } %>
    <% if (page.next) { %>
      <a class="post-nav-link next" href="<%= url_for(page.next.path) %>"><span>下一篇 →</span><%= page.next.title %></a>
    <% } else { %><span class="post-nav-link placeholder"></span><% } %>
  </nav>
</article>
